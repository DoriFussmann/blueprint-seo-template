{
  "name": "blueprint-seo-template",
  "private": true,
  "type": "module",
  "workspaces": ["site", "cms"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace=site",
    "build": "npm run build --workspace=site && npm run audit",
