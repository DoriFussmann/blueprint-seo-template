{
  "version": 2,
  "template": "midnight",
  "templateName": "Midnight",
  "tagline": "Anticipatory · human · decisive",
  "mode": "dark",
  "brand": { "wordmarkPrimary": "Site", "wordmarkAccent": "Name" },
  "colors": {
    "bg": "#071522",
    "surface": "#0C1D2C",
    "surfaceAlt": "#10263A",
    "fg": "#F3F0E7",
    "muted": "#A7B3BF",
    "border": "#1E3346",
    "accent": "#5AA8FF",
    "accentHover": "#8AC2FF",
    "accentFg": "#071522",
    "highlight": "#FF5D45",
    "band": "#FF5D45",
    "bandFg": "#071522",
    "bandMuted": "#3A150E",
    "headerBg": "#05121D",
    "headerFg": "#F3F0E7",
    "footerBg": "#04101A",
    "footerFg": "#F3F0E7",
    "focus": "#5AA8FF"
  },
  "type": {
    "family": "Inter Variable",
    "base": "17px",
    "scale": 1.28,
    "headingWeight": 600,
    "bodyWeight": 400,
    "headingTracking": "-0.025em",
    "headingLeading": 1.05,
    "eyebrow": "uppercase"
  },
  "shape": { "radius": "4px", "radiusLg": "8px", "button": "solid" },
  "layout": { "density": "regular", "container": "76rem", "measure": "42rem" },
  "variants": { "header": "blur", "hero": "glow", "card": "filled", "rhythm": "flat", "texture": "none" },
  "motion": {
    "style": "rise",
    "duration": 700,
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "stagger": 90,
    "carouselInterval": 6000
  },
  "imagery": {
    "treatment": "cinematic-dusk",
    "cssFilter": "saturate(0.9) contrast(1.1) brightness(0.95)",
    "radius": "6px",
    "aspect": "4:5",
    "direction": "Human-centred, cinematic images at dusk or blue hour: people in the moment of a decision. Deep navy shadows with warm coral or soft blue light. Anticipatory, quiet tension, shallow depth of field.",
    "avoid": "Stock-photo clichés (handshakes, pointing at screens), text or logos baked into the image, heavy gradients, neon, AI-looking gloss."
  },
  "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
}
