---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SAME_AS, SITE_NAME, SITE_URL } from "../config/site";
import { orgNode, websiteNode } from "seo-core";

const site = { siteUrl: SITE_URL, siteName: SITE_NAME, sameAs: SAME_AS };
const jsonLd = { "@context": "https://schema.org", "@graph": [orgNode(site), websiteNode(site)] };
---

<BaseLayout
  title={`Page not found — ${SITE_NAME}`}
  description="The page you requested is not in this publication. Use the navigation to return home or browse articles."
  canonicalPath="/404/"
  robots="noindex, follow"
  jsonLd={jsonLd}
>
  <div class="container-page py-16">
    <h1 class="font-serif text-4xl mb-4">Page not found</h1>
    <p class="mb-4">That URL is not part of this site.</p>
    <p><a class="text-accent underline" href="/">Return home</a></p>
  </div>
</BaseLayout>
