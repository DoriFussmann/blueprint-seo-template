---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ArticleListing from "../../components/ArticleListing.astro";
import { ARTICLES_BASE, SITE_NAME } from "../../config/site";
import { abs } from "../../lib/url";
import { breadcrumbNode, orgNode, websiteNode } from "../../lib/jsonld";

const PAGE_SIZE = 12;
const all = (await getCollection("articles", ({ data }) => data.draft !== true)).sort(
  (a, b) => (b.data.updatedDate || b.data.date).localeCompare(a.data.updatedDate || a.data.date),
);
const pages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const slice = all.slice(0, PAGE_SIZE);
const pillars = [...new Set(all.map((a) => a.data.pillarKeyword).filter(Boolean))] as string[];
const canonicalPath = `/${ARTICLES_BASE}/`;
const crumbs = [
  { name: "Home", href: abs("/") },
  { name: "Articles", href: abs(canonicalPath) },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [orgNode(), websiteNode(), breadcrumbNode(crumbs)],
};
---

<BaseLayout
  title={`${SITE_NAME} articles`}
  description="Browse published articles covering technical SEO, content strategy, and the operational systems behind them."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <div class="container-page py-10">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="font-serif text-4xl mb-6">Articles</h1>
    <ArticleListing articles={slice} pillars={pillars} page={1} pages={pages} />
  </div>
</BaseLayout>
