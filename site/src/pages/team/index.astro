---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { SITE_NAME } from "../../config/site";
import { abs } from "../../lib/url";
import { breadcrumbNode, orgNode, websiteNode } from "../../lib/jsonld";

const team = await getCollection("team");
const crumbs = [
  { name: "Home", href: abs("/") },
  { name: "Team", href: abs("/team/") },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [orgNode(), websiteNode(), breadcrumbNode(crumbs)],
};
---

<BaseLayout
  title={`${SITE_NAME} team`}
  description="People behind the publication — operators and editors who write, review, and maintain the guides on this site."
  canonicalPath="/team/"
  jsonLd={jsonLd}
>
  <div class="container-page py-10">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="font-serif text-4xl mb-8">Team</h1>
    <ul class="grid gap-8 md:grid-cols-2">
      {team.map((member) => (
        <li class="flex gap-4">
          <Image
            src={member.data.photo}
            width={120}
            height={120}
            alt={`${member.data.name} headshot`}
            loading="lazy"
            class="w-[120px] h-[120px] object-cover"
          />
          <div>
            <h2 class="font-serif text-2xl">
              <a class="hover:text-accent" href={`/team/${member.id}/`}>{member.data.name}</a>
            </h2>
            <p class="text-muted">{member.data.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
