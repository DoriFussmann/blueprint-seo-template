---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";

const members = await getCollection("team");
const title = `Team | ${SITE_NAME}`;
const description =
  "People behind this site. Default template author remains until Site Activation replaces or extends the team collection.";
---

<BaseLayout title={title} description={description} canonicalPath="/team/">
  <section class="page-wrap py-12">
    <h1 class="text-4xl">Team</h1>
    <ul class="mt-10 space-y-12">
      {members.map((member) => (
        <li id={member.data.slug}>
          <article class="flex flex-col gap-6 sm:flex-row">
            <Image
              src={member.data.photo}
              alt={`Portrait of ${member.data.name}`}
              width={160}
              height={160}
              class="h-40 w-40 object-cover"
              loading="lazy"
            />
            <div>
              <h2 class="text-2xl">{member.data.name}</h2>
              <p class="mt-1 text-muted">{member.data.role}</p>
              {member.data.credentials && (
                <p class="mt-1 text-sm text-muted">{member.data.credentials}</p>
              )}
              <p class="mt-4">{member.data.bio}</p>
              {member.data.sameAs.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-4">
                  {member.data.sameAs.map((url) => (
                    <li>
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        {url.replace(/^https?:\/\//, "")}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
