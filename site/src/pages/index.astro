---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME } from "../config/site";
import { pagePath } from "../lib/url";
import { formatDisplayDate } from "../lib/dates";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);

const latest = (await getCollection("articles"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 5);

const title = `${SITE_NAME}`;
const description =
  "Template homepage chrome. Replace this sentence at Site Activation with the real positioning line.";
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <section class="page-wrap py-16 lg:py-24">
    <h1 class="max-w-3xl text-4xl">{SITE_NAME}</h1>
    <p class="mt-6 max-w-3xl text-lg">
      Template homepage chrome. Replace this sentence at Site Activation with the real
      positioning line.
    </p>
  </section>

  {services.length > 0 && (
    <section class="page-wrap pb-16" aria-labelledby="services-heading">
      <h2 id="services-heading" class="mb-8 text-2xl">Services</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <article class="border border-border bg-surface p-6">
            <h3 class="text-xl">{service.data.title}</h3>
            <p class="mt-3">{service.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="page-wrap pb-16" aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="mb-8 text-2xl">Latest articles</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {latest.map((article) => (
          <article>
            <a href={pagePath(`/articles/${article.data.slug}`)} class="no-underline">
              <div class="hero-frame mb-3">
                <Image
                  src={article.data.image}
                  alt={article.data.imageAlt}
                  width={640}
                  height={360}
                  loading="lazy"
                />
              </div>
              <h3 class="text-xl">{article.data.title}</h3>
              <p class="mt-2 text-sm text-muted">{formatDisplayDate(article.data.date)}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
