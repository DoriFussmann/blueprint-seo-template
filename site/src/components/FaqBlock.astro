---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs?: Faq[];
}

const { faqs = [] } = Astro.props;
---

{faqs.length > 0 && (
  <section class="my-10">
    <h2 class="mb-4 text-xl">Frequently asked questions</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="border border-border bg-surface px-4 py-3">
          <summary class="tap-target cursor-pointer font-semibold text-heading">
            {faq.question}
          </summary>
          <p class="mt-3 text-body">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
