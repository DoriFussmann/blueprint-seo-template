---
import { ARTICLES_BASE, SITE_NAME } from "../config/site";
---

<header class="border-b border-border bg-surface">
  <div class="container-page flex items-center justify-between gap-4 py-2">
    <a href="/" class="font-serif text-xl py-3">{SITE_NAME}</a>
    <button
      type="button"
      id="nav-toggle"
      class="tap-target inline-flex items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="sr-only">Menu</span>
      <span aria-hidden="true">☰</span>
    </button>
    <nav id="site-nav" class="hidden md:block">
      <ul class="flex flex-col md:flex-row md:items-center">
        <li><a class="nav-link" href="/">Home</a></li>
        <li><a class="nav-link" href={`/${ARTICLES_BASE}/`}>Articles</a></li>
        <li><a class="nav-link" href="/team/">Team</a></li>
      </ul>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var toggle = document.getElementById("nav-toggle");
    var nav = document.getElementById("site-nav");
    if (!toggle || !nav) return;
    toggle.addEventListener("click", function () {
      var open = nav.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
  })();
</script>
