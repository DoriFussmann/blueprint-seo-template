---
import { SITE_NAME } from "../config/site";
import { pagePath } from "../lib/url";
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="page-wrap flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted">© {new Date().getFullYear()} {SITE_NAME}</p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-4">
        <li><a href={pagePath("/")} class="tap-target text-sm no-underline">Home</a></li>
        <li>
          <a href={pagePath("/articles/")} class="tap-target text-sm no-underline">Articles</a>
        </li>
        <li>
          <a href={pagePath("/team/")} class="tap-target text-sm no-underline">Team</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
