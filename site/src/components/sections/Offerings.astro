---
import { getCollection } from "astro:content";

interface Item {
  title: string;
  text: string;
  cta: { label: string; href: string };
}
interface Section {
  eyebrow?: string;
  heading: string;
  intro?: string;
  source: "services" | "items";
  items?: Item[];
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;

const cards: Item[] =
  section.source === "services"
    ? (await getCollection("services"))
        .sort((a, b) => a.data.order - b.data.order)
        .map((service) => ({
          title: service.data.title,
          text: service.data.description,
          cta: { label: "View service", href: `/services/${service.id}/` },
        }))
    : section.items ?? [];
---

<section class:list={["section", alt && "section-alt"]}>
  <div class="container-page flex flex-col gap-8">
    <div class="flex flex-col gap-3">
      {section.eyebrow && <p class="eyebrow reveal" data-index="0">{section.eyebrow}</p>}
      <h2 class="h2 reveal" data-index="1">{section.heading}</h2>
      {section.intro && <p class="lead reveal" data-index="2">{section.intro}</p>}
    </div>
    <ul class="grid gap-6 md:grid-cols-2">
      {cards.map((item, index) => (
        <li class="card flex flex-col gap-3 reveal" data-index={index}>
          <h3 class="h3">{item.title}</h3>
          <p class="muted">{item.text}</p>
          <a class="btn btn-secondary" href={item.cta.href}>{item.cta.label}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
