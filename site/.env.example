# Public build-time settings. Copy to .env for local overrides; set the same
# names in Vercel → Settings → Environment Variables for production.
# Leave a value empty to keep that feature off.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Optional: GA4_MEASUREMENT_ID in
# src/config/site.ts does the same from the repo; a value here overrides it.
PUBLIC_ANALYTICS_ID=

# Google Search Console HTML-tag verification token
PUBLIC_SEARCH_CONSOLE_VERIFICATION=
