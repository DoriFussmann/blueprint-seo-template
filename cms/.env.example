# DataForSEO — required for "Find & Approve External Links" in Articles Health
# Sign up at https://dataforseo.com to get these credentials
DATAFORSEO_LOGIN=your_login_here
DATAFORSEO_PASSWORD=your_password_here

# Google PageSpeed Insights API — required for PageSpeed scanning
# Get a key at https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=your_key_here
